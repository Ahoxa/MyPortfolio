---
import { IoMdMail } from "react-icons/io";
import { IoLogoGithub } from "react-icons/io5";
import { RxHamburgerMenu } from "react-icons/rx";
import * as styles from "./header.css.ts";
import Logo from "./Logo.astro";
import ThemeToggleButton from "./ThemeToggleButton.tsx";
---

<header class={styles.header}>
  <div class={styles.container}>
    <div class={styles.logoContainer}>
      <Logo />
    </div>

    <!-- hover-link and underline are unique class name -->
    <div class={styles.navContainer}>
      <a href="/" class={styles.navLink}>
        Home
        <span class={styles.underline}></span>
      </a>
      <span class={styles.separator}>/</span>
      <a href="/work" class={styles.navLink}>
        Work
        <span class={styles.underline}></span>
      </a>
      <span class={styles.separator}>/</span>
      <a href="/post" class={styles.navLink}>
        Post
        <span class={styles.underline}></span>
      </a>
    </div>

    <!-- Here ThemeToggleButton -->
    <div class={styles.actionsContainer}>
      <a href="/contact" class={styles.iconLink}>
        <IoMdMail size={25} />
      </a>
      <a
        href="https://github.com/Ahoxa/MyPortfolio"
        class={styles.githubIconLink}><IoLogoGithub size={25} /></a
      >
      <ThemeToggleButton client:load />

      <div class={styles.mobileMenuContainer}>
        <div tabindex="0" role="button" class={styles.menuButton}>
          <RxHamburgerMenu />
        </div>
        <ul tabindex="0" class={`${styles.menuContent} ${styles.menuList}`}>
          <li class={styles.menuItem}>
            <a href="/" class={styles.menuLink}>Home</a>
          </li>
          <li class={styles.menuItem}>
            <a href="/work" class={styles.menuLink}>Work</a>
          </li>
          <li class={styles.menuItem}>
            <a href="/post" class={styles.menuLink}>Post</a>
          </li>
        </ul>
      </div>
    </div>
  </div>
</header>
